{
  "name": "instaext",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun run build:chromium && bun run build:firefox",
    "build:chromium": "BROWSER=chromium vite build && BROWSER=chromium bun scripts/postbuild.mjs",
    "build:firefox": "BROWSER=firefox vite build && BROWSER=firefox bun scripts/postbuild.mjs",
    "dev": "bun run dev:chromium",
    "dev:chromium": "BROWSER=chromium vite build --watch",
    "dev:firefox": "BROWSER=firefox vite build --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/bun": "^1.3.13",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "jsdom": "^26.0.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.0",
    "vite": "^8.0.10",
    "vitest": "^3.0.0"
  },
  "dependencies": {},
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
