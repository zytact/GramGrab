{
  "name": "gramgrab",
  "type": "module",
  "private": true,
  "license": "GPL-3.0-only",
  "scripts": {
    "build": "vp run build-all",
    "build:chromium": "vp run build-chromium",
    "build:firefox": "vp run build-firefox",
    "dev": "BROWSER=chromium vp build --watch",
    "dev:chromium": "BROWSER=chromium vp build --watch",
    "dev:firefox": "BROWSER=firefox vp build --watch",
    "lint": "vp lint .",
    "lint:fix": "vp lint . --fix",
    "fallow": "fallow",
    "generate:ig-fixtures": "tsx scripts/generate-ig-fixture-capture.ts",
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "test": "vp test run",
    "test:watch": "vp test",
    "prepare": "vp config",
    "typecheck": "tsc --noEmit",
    "package:firefox": "vp run package-firefox",
    "package:chromium": "vp run package-chromium"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/bun": "^1.3.13",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "crx": "^5.0.1",
    "fallow": "^2.88.3",
    "jsdom": "^29.1.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.1.24",
    "vite-plus": "0.1.24",
    "vitest": "npm:@voidzero-dev/vite-plus-test@0.1.24"
  },
  "dependencies": {
    "effect": "^3.21.2"
  },
  "packageManager": "pnpm@11.5.1",
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.1.24",
    "vitest": "npm:@voidzero-dev/vite-plus-test@0.1.24"
  }
}
