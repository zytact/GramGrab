{
  "name": "gramgrab",
  "version": "0.1.1",
  "type": "module",
  "private": true,
  "bin": {
    "gramgrab": "artifacts/gramgrab.mjs"
  },
  "license": "GPL-3.0-only",
  "scripts": {
    "build": "vp run build-all",
    "build:chromium": "vp run build-chromium",
    "build:firefox": "vp run build-firefox",
    "dev": "BROWSER=chromium vp build --watch",
    "dev:chromium": "BROWSER=chromium vp build --watch",
    "dev:firefox": "BROWSER=firefox vp build --watch",
    "lint": "vp lint .",
    "lint:fix": "vp lint . --fix",
    "fallow": "fallow audit --base origin/main",
    "verify:whatsapp-packages": "node apps/extension/scripts/verify-whatsapp-package.mjs",
    "generate:ig-fixtures": "tsx apps/extension/scripts/generate-ig-fixture-capture.ts",
    "sanitize:ig-fixtures": "tsx apps/extension/scripts/sanitize-ig-fixtures.ts",
    "update:ig-protocol": "tsx apps/extension/scripts/update-ig-protocol.ts",
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "test": "vp test run",
    "test:watch": "vp test",
    "prepare": "vp config && vp run package-tools",
    "typecheck": "tsc --noEmit",
    "package:firefox": "vp run package-firefox",
    "package:chromium": "vp run package-chromium",
    "package:tools": "vp run package-tools"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/bun": "^1.3.13",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "acorn": "^8.17.0",
    "crx": "^5.0.1",
    "fallow": "^3.8.0",
    "jsdom": "^29.1.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.1.24",
    "vite-plus": "0.1.24",
    "vitest": "npm:@voidzero-dev/vite-plus-test@0.1.24"
  },
  "dependencies": {
    "effect": "^3.22.0"
  },
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.1.24",
    "vitest": "npm:@voidzero-dev/vite-plus-test@0.1.24"
  }
}
