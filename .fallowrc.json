{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "apps/extension/templates/popup.tsx",
    "apps/extension/templates/runner.ts",
    "apps/extension/src/runner.ts",
    "apps/extension/src/background.ts",
    "apps/*/src/index.ts",
    "packages/*/src/index.ts"
  ],
  "ignorePatterns": [".repos/**"],
  "duplicates": {
    // Hide pair-only clones; focus on widespread copy-paste
    // worth refactoring. Lower to 2 to report every duplicate pair.
    "minOccurrences": 3,
    // Test suites often repeat setup and assertions intentionally.
    "ignore": ["**/*.test.*", "**/*.spec.*"]
  },
  "rules": {
    "unused-dependencies": "warn"
  }
}
